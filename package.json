{
  "name": "npm-package-template",
  "version": "1.3.0",
  "description": "A modern TypeScript npm package template with automated publishing, testing, and tooling",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    ".github/ISSUE_TEMPLATE",
    ".github/workflows",
    ".github/pull_request_template.md",
    "dist",
    "docs",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "npm run check",
    "prepublishOnly": "npm run check",
    "init": "node scripts/init-from-template.js",
    "setup": "node scripts/setup.js",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-templates/npm-package-template.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://github.com/open-templates/npm-package-template#readme",
  "bugs": {
    "url": "https://github.com/open-templates/npm-package-template/issues"
  },
  "keywords": [
    "npm",
    "template",
    "typescript",
    "tsup",
    "vitest",
    "eslint",
    "github-actions",
    "automated-publishing",
    "esm"
  ],
  "author": "@open-templates",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.2.4"
  }
}

{
  "name": "your-package-name",
  "version": "0.0.0",
  "description": "Your package description",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "npm run check",
    "prepublishOnly": "npm run check",
    "setup": "node scripts/setup.js",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/YOUR_PACKAGE_NAME.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/YOUR_USERNAME/YOUR_PACKAGE_NAME#readme",
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/YOUR_PACKAGE_NAME/issues"
  },
  "keywords": [],
  "author": {
    "name": "YOUR_NAME",
    "email": "your.email@example.com",
    "url": "https://github.com/YOUR_USERNAME"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {}
}
